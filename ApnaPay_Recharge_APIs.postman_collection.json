{
  "info": {
    "_postman_id": "apnapay-recharge-apis-v1",
    "name": "ApnaPay - Recharge APIs",
    "description": "Complete testing collection for ApnaPay Mobile & DTH Recharge Module. Includes Operators, Plans, Recharge Orders, User History, Validations, and Status Lifecycle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "operatorId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "planId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "planAmount",
      "value": "299.00",
      "type": "string"
    },
    {
      "key": "mobileNumber",
      "value": "9876543210",
      "type": "string"
    },
    {
      "key": "rechargeId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "providerReference",
      "value": "RCH-MOCK-REF-101",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Checks if the ApnaPay backend server is online and running."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const res = pm.response.json();",
              "pm.test(\"Backend server is healthy\", function () {",
              "    pm.expect(res.success).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "1. Operators",
      "description": "Endpoints to list and inspect telecom and DTH recharge operators.",
      "item": [
        {
          "name": "1.1 Get All Active Operators",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recharge/operators",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "operators"
              ]
            },
            "description": "Fetches all active operators (Jio, Airtel, Vi, BSNL, Tata Play, etc.) and auto-saves the first prepaid operator's ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Operators array returned\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(Array.isArray(res.data)).to.be.true;",
                  "});",
                  "",
                  "if (res.data && res.data.length > 0) {",
                  "    const prepaidOp = res.data.find(o => o.service_type === 'prepaid') || res.data[0];",
                  "    pm.collectionVariables.set(\"operatorId\", prepaidOp.id.toString());",
                  "    console.log(\"Saved operatorId:\", prepaidOp.id, prepaidOp.operator_name);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "1.2 Filter Operators by Service Type (Prepaid)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recharge/operators?service_type=prepaid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "operators"
              ],
              "query": [
                {
                  "key": "service_type",
                  "value": "prepaid"
                }
              ]
            },
            "description": "Fetches only operators with service_type = 'prepaid'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"All operators are prepaid\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    res.data.forEach(function(op) {",
                  "        pm.expect(op.service_type).to.eql(\"prepaid\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "1.3 Get Operator by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recharge/operators/{{operatorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "operators",
                "{{operatorId}}"
              ]
            },
            "description": "Fetches details of a specific operator by ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Operator info returned\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data).to.have.property(\"operator_name\");",
                  "    pm.expect(res.data.id.toString()).to.eql(pm.collectionVariables.get(\"operatorId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "2. Recharge Plans",
      "description": "Endpoints to list, filter, and inspect recharge tariff plans.",
      "item": [
        {
          "name": "2.1 Get All Active Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recharge/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "plans"
              ]
            },
            "description": "Fetches all active recharge plans across operators and auto-saves the plan's ID, amount, and linked operatorId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Plans list returned\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(Array.isArray(res.data)).to.be.true;",
                  "});",
                  "",
                  "if (res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set(\"planId\", res.data[0].id.toString());",
                  "    pm.collectionVariables.set(\"planAmount\", parseFloat(res.data[0].amount).toFixed(2));",
                  "    if (res.data[0].operator_id) {",
                  "        pm.collectionVariables.set(\"operatorId\", res.data[0].operator_id.toString());",
                  "    }",
                  "    console.log(\"Saved planId:\", res.data[0].id, \"operatorId:\", res.data[0].operator_id, \"Amount:\", res.data[0].amount);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "2.2 Filter Plans by Operator",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recharge/plans?operator_id={{operatorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "plans"
              ],
              "query": [
                {
                  "key": "operator_id",
                  "value": "{{operatorId}}"
                }
              ]
            },
            "description": "Fetches plans available for the selected operator."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Filtered plans returned\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    res.data.forEach(function(plan) {",
                  "        pm.expect(plan.operator_id.toString()).to.eql(pm.collectionVariables.get(\"operatorId\"));",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "2.3 Get Plan Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recharge/plans/{{planId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "plans",
                "{{planId}}"
              ]
            },
            "description": "Fetches full details (name, validity, benefits) for a specific plan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Plan details returned\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data).to.have.property(\"plan_name\");",
                  "    pm.expect(res.data).to.have.property(\"amount\");",
                  "    pm.expect(res.data.id.toString()).to.eql(pm.collectionVariables.get(\"planId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "3. Create Recharge Orders",
      "description": "Endpoints to initiate recharge transactions, topups, and validation checks.",
      "item": [
        {
          "name": "3.1 Create Recharge Order (With Selected Plan)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": {{userId}},\n    \"operator_id\": {{operatorId}},\n    \"plan_id\": {{planId}},\n    \"mobile_number\": \"{{mobileNumber}}\",\n    \"amount\": {{planAmount}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recharge/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "create"
              ]
            },
            "description": "Creates a pending mobile recharge order linked to a specific plan. Saves recharge_id for downstream requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Recharge order created successfully\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data).to.have.property(\"recharge_id\");",
                  "    pm.expect(res.data.status).to.eql(\"pending\");",
                  "});",
                  "",
                  "if (res.data && res.data.recharge_id) {",
                  "    pm.collectionVariables.set(\"rechargeId\", res.data.recharge_id.toString());",
                  "    pm.collectionVariables.set(\"providerReference\", res.data.provider_reference);",
                  "    console.log(\"Saved rechargeId:\", res.data.recharge_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "3.2 Create Custom Topup Recharge (Without Plan)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": {{userId}},\n    \"operator_id\": {{operatorId}},\n    \"mobile_number\": \"{{mobileNumber}}\",\n    \"amount\": 50.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recharge/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "create"
              ]
            },
            "description": "Creates an ad-hoc talktime / topup recharge without attaching a plan_id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Topup created with null plan_id\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.plan_id).to.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "3.3 Validation Error - Invalid Mobile Number (Expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": {{userId}},\n    \"operator_id\": {{operatorId}},\n    \"mobile_number\": \"12345\",\n    \"amount\": 299.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recharge/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "create"
              ]
            },
            "description": "Negative test expecting 400 when an invalid non-Indian mobile number is provided."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Error message indicates invalid mobile number\", function () {",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.message).to.include(\"10 digit\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "3.4 Validation Error - Amount Mismatch with Plan (Expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": {{userId}},\n    \"operator_id\": {{operatorId}},\n    \"plan_id\": {{planId}},\n    \"mobile_number\": \"{{mobileNumber}}\",\n    \"amount\": 100.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recharge/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "create"
              ]
            },
            "description": "Negative test expecting 400 when the passed amount doesn't match the selected plan's fixed amount."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Error message indicates amount mismatch\", function () {",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.message).to.include(\"match selected plan\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
