                  "pm.test(\"Error message indicates invalid status\", function () {",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.message).to.include(\"Invalid recharge status\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
