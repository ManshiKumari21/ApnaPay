      ]
    },
    {
      "name": "5. Recharge Status Lifecycle (Testing Mock)",
      "description": "Endpoints to simulate provider callback status updates (pending -> processing -> success / failed).",
      "item": [
        {
          "name": "5.1 Mark Recharge as Processing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"processing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recharge/{{rechargeId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "{{rechargeId}}",
                "status"
              ]
            },
            "description": "Updates recharge status to 'processing' to simulate operator queueing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Status updated to processing\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.status).to.eql(\"processing\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "5.2 Mark Recharge as Success",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"success\",\n    \"provider_reference\": \"OP_TXN_SUCCESS_991823\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recharge/{{rechargeId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "{{rechargeId}}",
                "status"
              ]
            },
            "description": "Simulates operator success confirmation and saves operator provider reference."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Status updated to success\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.status).to.eql(\"success\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "5.3 Validation Error - Invalid Status (Expect 400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"unknown_mock_status\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recharge/{{rechargeId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recharge",
                "{{rechargeId}}",
                "status"
              ]
            },
            "description": "Negative test expecting 400 when an invalid status is submitted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
