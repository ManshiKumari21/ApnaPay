		{
			"name": "2. Submit KYC",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 201\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"const res = pm.response.json();",
							"if (res.kyc_record_id) {",
							"    pm.collectionVariables.set(\"kycRecordId\", res.kyc_record_id);",
							"    console.log(\"Saved kycRecordId:\", res.kyc_record_id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/kyc/submit",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"kyc",
						"submit"
					]
				},
				"description": "Submits a new KYC application for the user. If already submitted or approved, it returns the current status."
