		{
			"name": "3. Add KYC Document (Aadhaar Card)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"const res = pm.response.json();",
							"if (res.document && res.document.id) {",
							"    pm.collectionVariables.set(\"documentId\", res.document.id);",
							"    console.log(\"Auto-saved documentId:\", res.document.id);",
							"}"
